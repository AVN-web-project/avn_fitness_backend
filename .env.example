# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/avn_fitness

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_fitness_gear_2026_dev_mode
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_parser_key_2026

# Payment Gateway (Optional/Stubs for MVP)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# Media Storage (Cloudinary/R2 Placeholder)
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
